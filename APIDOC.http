# ==== COURSE_MANAGEMENT ====

#api for adimin register
POST http://127.0.0.1:8000/course/admin/
Content-Type: application/json

{
    "username":"admin",
    "email":"admin@gmail.com",
    "password":"admin@123"
}

# api for course listing
###
GET http://127.0.0.1:8000/course/create/?title=Programming
Accept: application/json
Authorization: Basic admin:admin@123

# api for course posting
###
POST http://127.0.0.1:8000/course/create/
Content-Type: application/json
Authorization: Basic admin:admin@123

  {
    "title": "SQL Database Development",
    "language": "SQL",
    "description": "Learn SQL queries, joins, subqueries, database relationships, normalization and database management.",
    "duration": "2 Months",
    "trainer": "Fathima Shirin",
    "price": "9000.00"
  }

# api for course retrieve
###
GET http://127.0.0.1:8000/course/create/1/
Accept: application/json
Authorization: Basic admin:admin@123  

# api for course updating
###
PUT  http://127.0.0.1:8000/course/create/1/
Content-Type: application/json
Authorization: Basic admin:admin@123

{
  "id": 1,
  "title": "Python Django Full Stack Development",
